# Copy to .env.local for local development, and add the same variables in
# Vercel (Project Settings -> Environment Variables). Never commit real values.

# --- Public (exposed to the browser) ----------------------------------------
# Canonical site URL, no trailing slash. Used for canonical tags, sitemap, Open Graph,
# JSON-LD and Pinterest links. Use http://localhost:3000 in .env.local.
NEXT_PUBLIC_SITE_URL=https://www.glutenfreerecipehub.com
# Brand name shown in the header, titles and structured data.
NEXT_PUBLIC_SITE_NAME="Gluten-Free Recipes"
# Optional: shown on the Contact and Privacy pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase project URL and publishable (anon) key: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy anon key also works if the publishable key is not set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ----------------------------
# Shared secret (32+ random characters) that lets the automation worker refresh
# cached recipe pages after it publishes. Set the same value in Vercel and in the
# GitHub "automation" environment. Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# Pinterest API v5 (OAuth). See docs/PINTEREST.md. Vercel (Production) only.
# App ID and App secret key from developers.pinterest.com -> My apps -> your app.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# 32 random bytes that encrypt the saved Pinterest tokens: openssl rand -base64 32
PINTEREST_TOKEN_ENCRYPTION_KEY=
# Optional. Must exactly match a Redirect URI registered in Pinterest Developers.
# Defaults to https://www.glutenfreerecipehub.com/api/pinterest/callback
# PINTEREST_REDIRECT_URI=

# Not used by the website. The automation worker uses it in GitHub Actions.
SUPABASE_SECRET_KEY=

# --- Automation worker (GitHub Actions only, see docs/AUTOMATION.md) ----------
# These are set in GitHub (Settings -> Environments -> automation), not in
# Vercel. They are listed here so you can run the worker locally if needed.
# AUTOMATION_ENABLED=false     # GitHub variable. Keep false until activation is approved.
# SITE_URL=https://www.glutenfreerecipehub.com   # GitHub variable. The live site, for page refreshes.
# ANTHROPIC_API_KEY=           # GitHub secret. Writes and reviews recipes, checks photos.
# OPENAI_API_KEY=              # GitHub secret. Generates the food photos.
# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high    # low | medium | high
