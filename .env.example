# Copy to .env.local for local development, and add the same variables in
# Vercel (Project Settings -> Environment Variables). Never commit real values.

# --- Public (exposed to the browser) ----------------------------------------
# Canonical site URL, no trailing slash. Used for canonical tags, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Brand name shown in the header, titles and structured data.
NEXT_PUBLIC_SITE_NAME="Crumb & Clover"
# Optional: shown on the Contact and Privacy pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase project URL and publishable (anon) key: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: the legacy anon key also works if the publishable key is not set.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ----------------------------
# Secret / service-role key. Not used by any Phase 1 feature; reserved for the
# future automation worker. Leave empty until that phase.
SUPABASE_SECRET_KEY=

# Future automation switch. Keep false: Phase 1 has no scheduler, AI generation
# or Pinterest API integration.
AUTOMATION_ENABLED=false
